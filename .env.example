# Skopírujte do .env.local a doplňte reálne hodnoty.
# .env.local je v .gitignore – nikdy ho necommitujte.

# ───────────── Analytika a overenie webu ─────────────

# Google Analytics 4 – merací identifikátor, napr. G-XXXXXXXXXX.
# Bez tejto premennej sa GA nenačíta vôbec (žiadne skripty, žiadne cookies).
# GA beží v režime Consent Mode v2: pred súhlasom v cookie lište neukladá cookies.
NEXT_PUBLIC_GA_ID=

# Google Search Console – overovací reťazec z metódy "HTML tag".
# Vloží sa ako <meta name="google-site-verification" content="...">.
# Ak overujete cez DNS záznam, nechajte prázdne.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools – overovací reťazec (meta msvalidate.01).
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ───────────── Formuláre a e-maily ─────────────

RESEND_API_KEY=
GOOGLE_SHEETS_WEBHOOK_URL=

SMARTEMAILING_USERNAME=
SMARTEMAILING_API_KEY=
SMARTEMAILING_LIST_ID=
SMARTEMAILING_CONTACT_LIST_ID=
