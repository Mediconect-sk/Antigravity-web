# Skopírujte do .env.local a doplňte reálne hodnoty.
# .env.local je v .gitignore – nikdy ho necommitujte.

# ───────────── Analytika a overenie webu ─────────────

# Vercel Web Analytics a Speed Insights nepotrebujú žiadnu premennú –
# stačí ich zapnúť v projekte vo Verceli (Analytics / Speed Insights → Enable).

# Google Analytics 4 (voliteľné, až pri platených kampaniach) – napr. G-XXXXXXXXXX.
# Bez tejto premennej sa GA nenačíta vôbec (žiadne skripty, žiadne cookies).
# GA beží v režime Consent Mode v2: pred súhlasom v cookie lište neukladá cookies.
NEXT_PUBLIC_GA_ID=

# Google Search Console – overovací reťazec z metódy "HTML tag".
# Vloží sa ako <meta name="google-site-verification" content="...">.
# Ak overujete cez DNS záznam, nechajte prázdne.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools – overovací reťazec (meta msvalidate.01).
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ───────────── Formuláre a e-maily ─────────────

RESEND_API_KEY=
GOOGLE_SHEETS_WEBHOOK_URL=

# Formuláre (dopyt, kontakt, newsletter) sa zapisujú do CRM Ordevia
# (src/lib/crm.ts). Obe premenné sú NEPOVINNÉ – bez nich sa použije
# produkčný projekt Ordevie a jeho verejný publishable kľúč.
# ORDEVIA_SUPABASE_URL=
# ORDEVIA_SUPABASE_PUBLISHABLE_KEY=
# SMARTEMAILING_* sa od 13. 10. 2026 nepoužívajú – SmartEmailing
# synchronizuje Ordevia (nočný cron), web ho priamo nevolá.
